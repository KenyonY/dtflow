#!/usr/bin/env python3
"""
DataTransformer 一键分析工具

最简单的用法：
    analyze your_data.jsonl

完整用法：
    analyze your_data.jsonl --output results/ --clusters 10
"""

import sys
import json
import argparse
from pathlib import Path
import warnings
warnings.filterwarnings('ignore')


def detect_format(file_path: str) -> str:
    """自动检测文件格式"""
    with open(file_path, 'r', encoding='utf-8') as f:
        first_line = f.readline().strip()

    try:
        data = json.loads(first_line)

        # 检测是否是SFT格式
        if 'messages' in data:
            return 'sft'
        elif 'instruction' in data and 'output' in data:
            return 'instruction-output'
        elif 'prompt' in data and 'completion' in data:
            return 'prompt-completion'
        elif 'question' in data and 'answer' in data:
            return 'qa'
        else:
            return 'unknown'
    except:
        return 'invalid'


def convert_to_sft_format(file_path: str, format_type: str) -> list:
    """将各种格式转换为SFT格式"""
    data = []

    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            if not line.strip():
                continue

            item = json.loads(line)

            if format_type == 'sft':
                # 提取instruction和output
                instruction = None
                output = None
                for msg in item.get('messages', []):
                    if msg.get('role') == 'user':
                        instruction = msg.get('content', '')
                    elif msg.get('role') == 'assistant':
                        output = msg.get('content', '')

                if instruction and output:
                    data.append({'instruction': instruction, 'output': output})

            elif format_type == 'instruction-output':
                data.append({
                    'instruction': item.get('instruction', ''),
                    'output': item.get('output', '')
                })

            elif format_type == 'prompt-completion':
                data.append({
                    'instruction': item.get('prompt', ''),
                    'output': item.get('completion', '')
                })

            elif format_type == 'qa':
                data.append({
                    'instruction': item.get('question', ''),
                    'output': item.get('answer', '')
                })

    return data


def print_welcome():
    """打印欢迎信息"""
    print("""
╔══════════════════════════════════════════════════════════════╗
║                                                              ║
║          📊 DataTransformer 一键分析工具 📊                  ║
║                                                              ║
║          轻松分析你的数据集质量和特征                          ║
║                                                              ║
╚══════════════════════════════════════════════════════════════╝
""")


def print_format_help():
    """打印格式帮助信息"""
    print("""
支持的数据格式：

1. SFT格式（推荐）:
   {"messages": [{"role": "user", "content": "问题"}, {"role": "assistant", "content": "答案"}]}

2. Instruction-Output格式:
   {"instruction": "问题", "output": "答案"}

3. Prompt-Completion格式:
   {"prompt": "问题", "completion": "答案"}

4. Question-Answer格式:
   {"question": "问题", "answer": "答案"}

💡 提示：每行一个JSON对象（JSONL格式）
""")


def main():
    parser = argparse.ArgumentParser(
        description='一键分析你的数据集',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  # 最简单的用法
  analyze my_data.jsonl

  # 指定输出目录
  analyze my_data.jsonl --output results/

  # 自定义聚类数
  analyze my_data.jsonl --clusters 20

  # 查看支持的格式
  analyze --formats
        """
    )

    parser.add_argument('file', nargs='?', help='数据文件路径（JSONL格式）')
    parser.add_argument('-o', '--output', default='analysis_results',
                       help='输出目录（默认: analysis_results）')
    parser.add_argument('-c', '--clusters', type=int, default=None,
                       help='聚类数量（默认: 自动推荐）')
    parser.add_argument('-m', '--method', choices=['auto', 'kmeans', 'hdbscan', 'hierarchical'],
                       default='auto',
                       help='聚类方法（默认: auto自动选择）')
    parser.add_argument('--no-report', action='store_true',
                       help='不生成HTML报告')
    parser.add_argument('--formats', action='store_true',
                       help='显示支持的数据格式')

    args = parser.parse_args()

    # 显示格式帮助
    if args.formats:
        print_format_help()
        return

    # 检查文件参数
    if not args.file:
        print_welcome()
        print("❌ 错误：请提供数据文件路径")
        print("\n用法: analyze your_data.jsonl")
        print("\n查看帮助: analyze --help")
        print("查看格式: analyze --formats")
        return

    print_welcome()

    # 检查文件是否存在
    if not Path(args.file).exists():
        print(f"❌ 错误：文件不存在: {args.file}")
        return

    print(f"📂 正在分析: {args.file}")
    print(f"📁 输出目录: {args.output}")
    print()

    try:
        # 检测格式
        print("🔍 步骤 1/4: 检测数据格式...")
        format_type = detect_format(args.file)

        if format_type == 'invalid':
            print("❌ 错误：文件格式无效，请确保是JSONL格式（每行一个JSON对象）")
            return

        if format_type == 'unknown':
            print("⚠️  警告：无法识别数据格式，尝试作为通用格式处理")
            print("💡 提示：运行 'analyze --formats' 查看支持的格式")
        else:
            format_names = {
                'sft': 'SFT消息格式',
                'instruction-output': 'Instruction-Output格式',
                'prompt-completion': 'Prompt-Completion格式',
                'qa': 'Question-Answer格式'
            }
            print(f"✓ 检测到格式: {format_names.get(format_type, format_type)}")

        # 加载和转换数据
        print("\n📥 步骤 2/4: 加载数据...")
        data = convert_to_sft_format(args.file, format_type)

        if not data:
            print("❌ 错误：未能加载任何数据，请检查文件格式")
            return

        print(f"✓ 成功加载 {len(data)} 条数据")

        # 导入分析器
        print("\n🔧 步骤 3/4: 初始化分析器...")
        try:
            from data_transformer.analysis.analyzer import SFTDataAnalyzer
        except ImportError:
            print("❌ 错误：未安装 data_transformer 库")
            print("💡 安装命令: pip install -e .")
            return

        # 智能选择聚类参数
        data_size = len(data)

        # 自动推荐聚类数（基于数据规模）
        if args.clusters is None:
            if data_size < 50:
                recommended_clusters = max(3, data_size // 5)
            elif data_size < 200:
                recommended_clusters = max(5, data_size // 10)
            elif data_size < 1000:
                recommended_clusters = max(10, data_size // 20)
            else:
                recommended_clusters = max(20, min(100, data_size // 50))
            n_clusters = recommended_clusters
        else:
            n_clusters = args.clusters

        # 自动选择聚类方法
        if args.method == 'auto':
            if data_size < 500:
                clustering_method = 'hdbscan'  # 小数据集用HDBSCAN（自动发现聚类数）
                print(f"📍 自动选择聚类方法: HDBSCAN（自动发现聚类数）")
            else:
                clustering_method = 'hierarchical'  # 大数据集用分层聚类
                print(f"📍 自动选择聚类方法: 分层聚类（粗聚类+细聚类）")
                print(f"📍 KMeans聚类数: {n_clusters}")
        else:
            clustering_method = args.method
            if clustering_method == 'kmeans':
                print(f"📍 使用 KMeans 聚类，聚类数: {n_clusters}")
            elif clustering_method == 'hdbscan':
                print(f"📍 使用 HDBSCAN 聚类（自动发现聚类数）")
            else:
                print(f"📍 使用分层聚类，KMeans聚类数: {n_clusters}")

        # 创建分析器
        min_cluster_size = max(5, min(50, data_size // 20))
        analyzer = SFTDataAnalyzer(
            n_clusters=n_clusters,
            min_cluster_size=min_cluster_size,
            output_dir=args.output
        )
        print("✓ 分析器初始化完成")

        # 运行分析
        print("\n📊 步骤 4/4: 运行分析（这可能需要几秒到几分钟）...")
        results = analyzer.analyze(
            data,
            clustering_method=clustering_method,
            generate_report=not args.no_report,
            cache_embeddings=False
        )

        # 打印成功信息
        print("\n" + "="*60)
        print("🎉 分析完成！")
        print("="*60)

        print(f"\n📈 分析摘要:")
        print(f"  • 数据量: {len(data)} 条")
        print(f"  • 聚类数: {results.get('clustering', {}).get('n_clusters', 'N/A') if isinstance(results.get('clustering'), dict) else results.get('clustering').n_clusters}")
        print(f"  • 质量分数: {results['quality'].get('overall_score', 'N/A'):.1f}/100")

        print(f"\n📁 结果保存在: {args.output}/")
        print(f"  • analysis_results.json - 完整分析数据")
        if not args.no_report:
            print(f"  • analysis_report.html - 可视化报告（用浏览器打开）")
        print(f"  • *.png - 可视化图表")

        print("\n💡 下一步:")
        if not args.no_report:
            print(f"  1. 打开 {args.output}/analysis_report.html 查看完整报告")
        print(f"  2. 查看 {args.output}/analysis_results.json 获取详细数据")
        print(f"  3. 根据质量分数和建议改进你的数据集")

        print("\n✨ 感谢使用 DataTransformer!")

    except KeyboardInterrupt:
        print("\n\n⚠️  分析已取消")
        sys.exit(1)
    except Exception as e:
        print(f"\n❌ 分析失败: {e}")
        print("\n💡 获取帮助:")
        print("  1. 运行 'analyze --formats' 查看支持的格式")
        print("  2. 检查数据文件是否符合JSONL格式")
        print("  3. 查看文档或提交issue获取帮助")
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == '__main__':
    main()
